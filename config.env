# ============================================== KernelSU Action -- 编译配置文件
#
# 此处填写默认参数；工作流运行时弹窗输入的值优先级高于本文件。
# 只有精确填写字符串 "true" (yes/on/1) 代表开启功能。
#
# 你可以把配置保存到 config/设备名.env 实现多设备配置隔离，
# 启动编译时在【Config file to build】选择对应的配置文件即可。
CONFIG_ENV=config.env

# ============================================== 【内核源码相关配置】
# 内核源码仓库地址
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
# 内核源码分支 lineage‑21 = Android14 和 crDroid10匹配，千万不要填lineage‑22.2(安卓15不兼容)
KERNEL_SOURCE_BRANCH=munch-s-oss
# 小米6内核配置文件名 sagit_defconfig
KERNEL_CONFIG=vendor/munch_user_defconfig
# 编译后输出的内核镜像文件名，小米6为Image.gz‑dtb
# KERNEL_IMAGE_NAME=Image.gz-dtb
KERNEL_IMAGE_NAME=Image.gz
# CPU架构 骁龙835 为arm64
ARCH=arm64
# 【可选】自定义内核名称，会写入内核版本号以及压缩包文件名，留空自动从defconfig获取
KERNEL_NAME=
# 是否把自定义内核名追加到刷机包文件名后面 false=关闭
ADD_LOCALVERSION_TO_FILENAME=false
# 每次make编译追加的额外参数
# 小米6‑4.4老内核禁止开启完整LLVM编译，所以这里不填 LLVM=1 LLVM_IAS=1
# EXTRA_CMDS:V=1 LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
# EXTRA_CMDS:V=1 LLVM_IAS=0 KCFLAGS=-Wno-error=strict-prototypes
# EXTRA_CMDS:V=1 LLVM=1 LLVM_IAS=0 KCFLAGS=-Wno-error=strict-prototypes
# EXTRA_CMDS:V=1 KCFLAGS=-Wno-error=strict-prototypes
EXTRA_CMDS:V=1 CC=clang KCFLAGS=-Wno-error=strict-prototypes
# EXTRA_CMDS:V=1 LLVM=1 LLVM_IAS=0 KCFLAGS=-Wno-error=strict-prototypes
# EXTRA_CMDS:V=1 LLVM=1 LLVM_IAS=0 KCFLAGS=-Wno-error=strict-prototypes KCFLAGS=-Wno-error=unknown-warning-option KCFLAGS=-Wno-error=implicit-function-declaration


# 自定义编译环境变量，交叉编译器前缀
# CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-android-

# ============================================== 【Clang编译器配置】
#
# AOSP官方预编译Clang编译器分支说明：
#   main-kernel               r596125   (最新编译器,适合5.10+新内核)
#   main-kernel-2026          r584948c
#   main-kernel-2025          r547379
#   main-kernel-build-2024    r510928
#   master-kernel-build-2022  r450784e  ✅ 安全选项，4.4/4.9/4.19老内核首选
#   master-kernel-build-2021  r416183b  ✅ 安全选项，4.4/4.9/4.19老内核首选
#
# 新版Clang对老旧4.x内核会爆出大量警告错误导致编译失败
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
# 是否使用你自己提供的自定义clang编译器 false=关闭，使用AOSP内置clang
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
# 是否完整开启LLVM编译(LLVM=1 LLVM_IAS=1)
# ⚠️小米6 4.4内核开启USE_LLVM=true极高概率编译失败！必须false！
USE_LLVM=false

# ============================================== 【GCC编译器 仅作为汇编器依赖】
#
# 老内核无法使用LLVM内置汇编器的时候才需要GCC工具链，4.4内核开启这两项
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
# 是否使用自定义64位GCC编译器 false关闭
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
# CUSTOM_GCC_64_BIN=aarch64-linux-gnu-
CUSTOM_GCC_64_BIN=aarch64-linux-android-

# 是否使用自定义32位GCC编译器 false关闭
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
# CUSTOM_GCC_32_BIN=arm-linux-gnueabi-
CUSTOM_GCC_32_BIN=arm-linux-androideabi-


# ============================================== 【Root方案‑KernelSU / ReSukiSU 核心配置】
#
# KSU_VARIANT 可选择的root方案说明:
#   none           不集成任何root，编译纯净内核
#   kernelsu       原版tiann‑KernelSU，v1.0以后放弃5.10以下老内核，小米6不可用
#   kernelsu-next  KernelSU‑Next新版本
#   sukisu-ultra   SukiSU‑Ultra，带SUSFS隐藏功能
#   resukisu       ✅ ReSukiSU，专门适配4.x老旧非GKI内核，小米6首选
#   rsuntk         rsuntk改版KernelSU
#   backslashxx    面向手动钩子的改版内核SU
#
# KSU_REF 指定分支/tag/commit编号，留空action自动选择适配老内核的分支
KSU_VARIANT=none
KSU_REF=
# 钩子注入模式
# auto 自动选择；kprobes 探针(4.4内核没有kprobes不可用！)；manual 手动补丁钩子
# syscall/tracepoint 其他钩子方式
# ⭐小米6强制 manual！auto不会自动识别4.4，会错误选用kprobes导致root失效
KSU_HOOK_MODE=manual
# 管理器APK校验签名，留空使用官方ReSukiSU管理器，无需修改
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ============================================== 【SUSFS 防root检测隐藏模块】
#
# SUSFS用来隐藏挂载点、root文件路径，对抗应用root检测
# 老4.4内核susfs补丁冲突概率很高，新手建议false关闭，需要再开启
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ============================================== 【额外内核补丁选项】
#
# path_umount()函数是Linux5.9才加入，KernelSU卸载overlay依赖该函数
# 低于5.9的老内核需要手动向后移植该函数；小米6‑4.4打开true
ENABLE_PATH_UMOUNT=false
# 在SUSFS基础上开启更多指纹隐藏选项
ENABLE_HIDE_STUFF=false
# KPM内核补丁模块支持，arm64专用，ReSukiSU老内核一般关闭
ENABLE_KPM=false

# ============================================== 【内核配置Kconfig开关】
# 是否开启kprobes支持；小米6内核4.4无kprobes，必须false
ADD_KPROBES_CONFIG=false
# 开启overlayfs文件系统支持，KernelSU模块必备，true打开
ADD_OVERLAYFS_CONFIG=false
# 关闭LTO链接时优化，false=保持内核原有LTO设置
DISABLE_LTO=false
# 关闭警告当作错误，防止新版clang警告直接终止编译，老内核建议true
DISABLE_CC_WERROR=true
# 额外追加到defconfig的配置项，多条用空格隔开，不需要则留空
# EXTRA_DEFCONFIG=
EXTRA_DEFCONFIG=CONFIG_LD_IS_LLD=n

# ============================================== 【AnyKernel3刷机打包配置】
# 是否使用你自己仓库的AnyKernel3，false=使用Action内置AnyKernel3
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================== 【产物打包设置】
# 是否需要单独dtbo镜像；小米6 dtb内置在内核镜像，不需要dtbo分区，false
NEED_DTBO=false
# 是否自动把新内核+外部boot镜像重打包成完整boot.img
# AnyKernel刷机包不需要开启，false关闭
BUILD_BOOT_IMG=false
# BUILD_BOOT_IMG=true
# 如果你开启BUILD_BOOT_IMG，这里填入原版boot镜像直链下载地址
SOURCE_BOOT_IMAGE=
# SOURCE_BOOT_IMAGE=https://github.com/you10069/KernelSU_Action/releases/download/Cr10.11/boot.img

# ============================================== 【编译运行环境优化】
# 开启ccache缓存，二次编译速度大幅加快 true开启
ENABLE_CCACHE=true
# 编译前移除容器内无用安装包，节省空间 true开启
REMOVE_UNUSED_PACKAGES=true
